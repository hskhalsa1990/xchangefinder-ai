# XchangeFinder polyglot CLI Makefile
# Usage: make all | make c | make cpp | make go | make bash | make run

.PHONY: all c cpp go bash run clean

DATA := data
BIN  := bin

all: c cpp go
	@echo "All binaries built in $(BIN)/"

$(BIN):
	mkdir -p $(BIN)

c: $(BIN)
	gcc -O2 -Wall -o $(BIN)/xfinder_c c/xfinder.c
	@echo "Built $(BIN)/xfinder_c"

cpp: $(BIN)
	g++ -std=c++17 -O2 -Wall -o $(BIN)/xfinder_cpp cpp/xfinder.cpp
	@echo "Built $(BIN)/xfinder_cpp"

go: $(BIN)
	cd go && go build -o ../$(BIN)/xfinder_go .
	@echo "Built $(BIN)/xfinder_go"

bash:
	chmod +x bash/xfinder.sh
	@echo "bash/xfinder.sh is executable"

run: all bash
	@echo "======== BASH ========"
	./bash/xfinder.sh summary
	@echo "======== C ========"
	cd c && ../$(BIN)/xfinder_c summary
	@echo "======== C++ ========"
	cd cpp && ../$(BIN)/xfinder_cpp summary
	@echo "======== GO ========"
	cd go && ../$(BIN)/xfinder_go summary

clean:
	rm -rf $(BIN)
